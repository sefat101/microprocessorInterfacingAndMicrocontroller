/**
 * SPI SWITCH SLAVE — Pure Bare Metal — NUCLEO-F446RE
 * Flash THIS project to the SLAVE board.
 * Uses SPI2 (PB13/14/15) so the LED on PA5 stays free.
 *
 * DEMO: on receiving 'S' from the master it blinks 5×, then loads the ack
 * byte 'D' into its SPI register so the master's next read returns 'D'.
 * Idle: dark.
 *
 * WIRING (3 wires + GND): PB13(SCK)←PB13, PB15(MOSI)←PB15,
 *                         PB14(MISO)→PB14, GND↔GND
 * LED: PA5     LINK: SPI2 slave mode
 */

#define BLINK_MS  200

#define RCC_AHB1ENR  (*(volatile unsigned int *)0x40023830)
#define RCC_APB1ENR  (*(volatile unsigned int *)0x40023840)
#define GPIOA_MODER  (*(volatile unsigned int *)0x40020000)
#define GPIOA_ODR    (*(volatile unsigned int *)0x40020014)
#define GPIOB_MODER  (*(volatile unsigned int *)0x40020400)
#define GPIOB_AFRH   (*(volatile unsigned int *)0x40020424)
#define SPI2_CR1     (*(volatile unsigned int *)0x40003800)
#define SPI2_SR      (*(volatile unsigned int *)0x40003808)
#define SPI2_DR      (*(volatile unsigned int *)0x4000380C)

void SystemInit(void) __attribute__((weak));        void SystemInit(void) { }
void __libc_init_array(void) __attribute__((weak)); void __libc_init_array(void) { }

static void delay_ms(unsigned int ms) {
    for (unsigned int m = 0; m < ms; m++)
        for (volatile unsigned int i = 0; i < 1300; i++);
}
static void blink(int times) {
    for (int i = 0; i < times; i++) { GPIOA_ODR |= (1<<5); delay_ms(BLINK_MS); GPIOA_ODR &= ~(1<<5); delay_ms(BLINK_MS); }
}

int main(void)
{
    RCC_AHB1ENR |= (1 << 0) | (1 << 1);   /* GPIOA + GPIOB */
    RCC_APB1ENR |= (1 << 14);             /* SPI2 */

    GPIOA_MODER &= ~(3 << 10);  GPIOA_MODER |= (1 << 10);         /* PA5 LED */
    GPIOB_MODER &= ~((3 << 26) | (3 << 28) | (3U << 30));         /* PB13/14/15 AF5 */
    GPIOB_MODER |=  ((2 << 26) | (2 << 28) | (2U << 30));
    GPIOB_AFRH  &= ~((0xF << 20) | (0xF << 24) | (0xFU << 28));
    GPIOB_AFRH  |=  ((5 << 20) | (5 << 24) | (5U << 28));

    SPI2_CR1 = (1 << 9) | (1 << 6);       /* slave, software NSS selected, enable */

    while (!(SPI2_SR & (1 << 1)));  SPI2_DR = 0x00;   /* default response */

    while (1) {
        while (!(SPI2_SR & (1 << 0)));    /* RXNE: byte from master */
        unsigned char b = (unsigned char)SPI2_DR;

        if (b == 'S') {
            blink(5);                      /* show the request */
            while (!(SPI2_SR & (1 << 1)));
            SPI2_DR = 'D';                 /* ack ready for the master's next read */
        } else {
            while (!(SPI2_SR & (1 << 1)));
            SPI2_DR = 0x00;                /* not an ack */
        }
    }
}
